# AgentKit — Variables de entorno
# Copia este archivo como .env y llena tus datos:
#   cp .env.example .env
#
# Claude Code te ayuda a llenar estos valores durante el setup.
# NUNCA subas el archivo .env a GitHub.

# ── Anthropic API ──────────────────────────────────────────
# Obtener en: https://platform.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=

# ── Proveedor de WhatsApp ──────────────────────────────────
# Opciones: meta | twilio
WHATSAPP_PROVIDER=

# ── Webhook verification (Meta Cloud API) ─────────────────
# Token secreto que Meta usa para verificar tu webhook (GET /webhook).
# Debe coincidir con el Verify Token configurado en Facebook Developers.
WEBHOOK_VERIFY_TOKEN=

# ── Meta Cloud API (si WHATSAPP_PROVIDER=meta) ────────────
# Configurar en: https://developers.facebook.com
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=

# ── Twilio (si WHATSAPP_PROVIDER=twilio) ──────────────────
# Configurar en: https://twilio.com
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ── Alertas por email (opcional) ──────────────────────────
# Si se configuran, Vicente envía un email cuando no puede responder a un cliente.
# Usar una cuenta Gmail + contraseña de aplicación (no la contraseña normal).
# Crear contraseña de app en: https://myaccount.google.com/apppasswords
# GMAIL_USER=tucuenta@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Servidor ──────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development

# ── Base de datos ─────────────────────────────────────────
# Local (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./agentkit.db
# Produccion (PostgreSQL en Railway):
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
